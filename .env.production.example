# ============================================================
#  .env.production.example
#  Copia este archivo en el VPS como: .env
#  NUNCA subas el .env real al repositorio
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # service_role key (larga)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...          # anon key (pública)

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-un-string-muy-largo-y-aleatorio-min-32-chars
JWT_EXPIRES_IN=7d

# ─── URLs de producción ──────────────────────────────────────
# La URL donde estará el frontend (con tu dominio real)
FRONTEND_URL=https://TU_DOMINIO.COM
# La URL que usará el frontend para llamar al backend
VITE_API_URL=https://api.TU_DOMINIO.COM

# ─── IA (opcional, dejar vacío si no se usa) ─────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
